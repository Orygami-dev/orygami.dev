---
import BrowserMockup from './BrowserMockup.astro';
import logo from '../assets/logo.png';
---

<section class="hero">
  <a href="/" class="hero__logo">
    <img src={logo.src} alt="Orygami.dev" width="180" height="50" />
  </a>
  <div class="hero__container">
    <div class="hero__content">
      <h1 class="hero__title">
        Votre site web vitrine,
        <span class="hero__title-accent">sur-mesure</span>
      </h1>
      <p class="hero__subtitle">
        Je crée des sites web modernes et performants pour les PME qui veulent se démarquer en ligne. Design soigné, responsive et optimisé pour le référencement.
      </p>
      <div class="hero__actions">
        <a href="#contact" class="hero__cta-primary">
          Discutons de votre projet
        </a>
        <a href="#portfolio" class="hero__cta-secondary">
          Voir mes réalisations
        </a>
      </div>
    </div>
    <div class="hero__visual">
      <BrowserMockup />
    </div>
  </div>
  <a href="#services" class="hero__scroll-arrow">
    <span class="hero__scroll-label">Découvrir mon travail</span>
    <svg viewBox="0 0 24 48" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path class="hero__scroll-shaft" pathLength="1" d="M10 2 C14 14, 15 26, 12 40" stroke-width="2.5" stroke-linecap="round" />
      <path class="hero__scroll-head" pathLength="1" d="M5 33 C8 38, 10 41, 12 44 C14 40, 17 37, 20 34" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </a>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 4rem;
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 39px,
        rgba(95, 179, 162, 0.07) 39px,
        rgba(95, 179, 162, 0.07) 40px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 39px,
        rgba(95, 179, 162, 0.07) 39px,
        rgba(95, 179, 162, 0.07) 40px
      ),
      linear-gradient(180deg, $background 0%, $primary-light 100%);

    &__logo {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 10;

      img {
        height: 36px;
        width: auto;
      }

      @include lg {
        right: 2rem;

        img {
          height: 44px;
        }
      }
    }

    &__container {
      @include container;
      display: grid;
      grid-template-columns: 1fr;
      flex: 1;
      gap: 3rem;
      align-items: center;
      align-content: center;

      @include md {
        grid-template-columns: 1fr 1fr;
      }
    }

    &__content {
      text-align: center;

      @include lg {
        text-align: left;
      }
    }

    &__title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 2.75rem;
      line-height: 1.3;
      margin-bottom: 1.5rem;

      @include md {
        font-size: 3.75rem;
      }

      @include lg {
        font-size: 4.5rem;
      }
    }

    &__title-accent {
      color: $primary;
      display: block;
    }

    &__subtitle {
      font-size: 1.125rem;
      color: $text-light;
      max-width: 540px;
      margin: 0 auto 2rem;

      @include lg {
        margin: 0 0 2rem;
        font-size: 1.25rem;
      }
    }

    &__actions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;

      @include sm {
        flex-direction: row;
        justify-content: center;
      }

      @include lg {
        justify-content: flex-start;
      }
    }

    &__cta-primary {
      @include button-primary;
      width: 100%;

      @include sm {
        width: auto;
      }
    }

    &__cta-secondary {
      @include button-secondary;
      width: 100%;

      @include sm {
        width: auto;
      }
    }

    &__visual {
      display: none;
      position: relative;

      @include md {
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    &__scroll-arrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      margin: 2rem auto 1.5rem;
      text-decoration: none;
      color: $text;
      opacity: 0;
      animation: hero-scroll-in 0.6s ease-out 0.8s forwards;

      &:hover,
      &:focus-visible {
        color: $primary-dark;

        svg {
          stroke: $primary-dark;
          animation-duration: 0.9s;
        }

        .hero__scroll-label::after {
          transform: scaleX(1);
        }
      }

      svg {
        width: 28px;
        height: 56px;
        stroke: $text;
        transition: stroke 0.3s ease;
        animation: hero-scroll-bob 2s ease-in-out 2.2s infinite;
      }

      @include lg {
        position: absolute;
        bottom: 2rem;
        right: 2.5rem;
        flex-direction: row;
        gap: 0.75rem;
        margin: 0;

        svg {
          width: 32px;
          height: 64px;
        }
      }
    }

    &__scroll-shaft,
    &__scroll-head {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hero-scroll-draw 0.6s ease-out forwards;
    }

    &__scroll-shaft {
      animation-delay: 1.1s;
    }

    &__scroll-head {
      animation-delay: 1.6s;
    }

    &__scroll-label {
      position: relative;
      font-family: 'Caveat', cursive;
      font-size: 1.85rem;
      line-height: 1;
      color: inherit;
      white-space: nowrap;
      transform: rotate(-3deg);

      &::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.2rem;
        height: 0.35rem;
        border-radius: 999px;
        background: $accent;
        opacity: 0.7;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.35s ease;
        z-index: -1;
      }

      @include lg {
        font-size: 2.25rem;
      }
    }
  }

  @keyframes hero-scroll-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-scroll-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-scroll-bob {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-arrow,
    .hero__scroll-arrow svg,
    .hero__scroll-shaft,
    .hero__scroll-head {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }

    .hero__scroll-label::after {
      transition: none;
    }
  }
</style>
